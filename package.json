{
  "name": "shop-quan-ao-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install --include=dev",
    "install:all": "cd client && npm install --include=dev && cd ../server && npm install",
    "build:client": "cd client && npx vite build",
    "vercel-build": "cd client && npx vite build",
    "check-deploy": "node check-deploy.js",
    "generate-secrets": "node generate-secrets.js"
  }
}
