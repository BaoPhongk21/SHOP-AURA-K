# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend & Backend URLs (REQUIRED for production)
BACKEND_URL=https://your-backend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# JWT Secret (REQUIRED - Change this to a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production_make_it_very_long_and_random_string

# Database Configuration (REQUIRED)
DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Alternative individual database config (fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_quan_ao
DB_USER=postgres
DB_PASS=password

# Email Configuration (Use App-Specific Password for Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password_here

# VNPay Payment Gateway (Optional)
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret

# Google Gemini API (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Required only when intentionally running a seed script
SEED_DEFAULT_PASSWORD=replace_with_a_temporary_strong_password
SEED_ADMIN_EMAIL=admin@example.com

# Node Version
NODE_VERSION=20.x
