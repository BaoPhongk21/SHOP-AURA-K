# Environment
NODE_ENV=development
PORT=5000

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# PostgreSQL (prefer DATABASE_URL in production)
DATABASE_URL=postgres://user:password@localhost:5432/shop_quan_ao
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASS=your_database_password
# DB_NAME=shop_quan_ao
# DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Optional integrations
GEMINI_API_KEY=your_gemini_api_key_here
VNP_TMN_CODE=your_vnpay_terminal_code
VNP_HASH_SECRET=your_vnpay_hash_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Aura K Shop

# Required only when intentionally running a seed script
SEED_DEFAULT_PASSWORD=replace_with_a_temporary_strong_password
